/* pages-study/essay-detail/essay-detail.wxss */
.page { padding: 24rpx 24rpx 60rpx; }

/* 头部 */
.head {
  background: #fff;
  border-radius: var(--r-md);
  padding: 28rpx 24rpx;
  margin-bottom: 22rpx;
}
.head-topic {
  font-size: 20rpx;
  color: var(--c-primary);
  background: var(--c-primary-light);
  border-radius: 6rpx;
  padding: 4rpx 14rpx;
}
.head-fav { font-size: var(--fs-sm); color: var(--c-text-3); }
.head-fav.on { color: var(--c-fuzzy); font-weight: 600; }
.head-title {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.45;
  margin: 18rpx 0 10rpx;
}
.head-level { font-size: 22rpx; font-weight: 600; }

/* 通用 */
.sec-title {
  display: block;
  font-size: var(--fs-lg);
  font-weight: 600;
  margin-bottom: 18rpx;
}
.mb-sm { margin-bottom: 12rpx; }
.mb-16 { margin-bottom: 24rpx; }
.mt-24 { margin-top: 24rpx; }

/* 框架 */
.frame-row { display: flex; margin-bottom: 22rpx; }
.frame-row:last-child { margin-bottom: 0; }
.frame-idx {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--c-primary-light);
  color: var(--c-primary);
  font-size: 24rpx;
  font-weight: 600;
  text-align: center;
  line-height: 44rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.frame-k { display: block; font-size: 30rpx; font-weight: 600; }
.frame-v {
  display: block;
  font-size: var(--fs-sm);
  color: var(--c-text-2);
  line-height: 1.7;
  margin-top: 6rpx;
}

/* 金句 */
.phrase-row { display: flex; align-items: flex-start; margin-bottom: 18rpx; }
.phrase-box {
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  border: 2rpx solid #d7dde8;
  color: #fff;
  font-size: 24rpx;
  text-align: center;
  line-height: 36rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.phrase-box.checked { background: var(--c-mastered); border-color: var(--c-mastered); }
.phrase-text { flex: 1; font-size: var(--fs-base); line-height: 1.7; color: var(--c-text); }
.phrase-text.done { color: var(--c-text-3); text-decoration: line-through; }

/* 槽位 */
.fill-row { display: flex; margin-bottom: 12rpx; }
.fill-dot { color: var(--c-primary); margin-right: 12rpx; }
.fill-text { flex: 1; font-size: var(--fs-base); color: var(--c-text-2); line-height: 1.65; }

/* 示范 */
.sample-text {
  display: block;
  font-size: var(--fs-base);
  line-height: 1.9;
  color: var(--c-text);
  white-space: pre-wrap;
  background: var(--c-bg);
  border-radius: var(--r-sm);
  padding: 22rpx;
}

/* 易错 */
.trick-box {
  background: #fff9e9;
  border-radius: var(--r-sm);
  padding: 22rpx;
  border-left: 6rpx solid #ffb020;
  margin-bottom: 22rpx;
}
.trick-label { display: block; font-size: 22rpx; font-weight: 600; color: #b3730a; margin-bottom: 8rpx; }
.trick-text { font-size: var(--fs-sm); color: #8a5a06; line-height: 1.7; }

/* 草稿 */
.draft-area {
  width: 100%;
  min-height: 320rpx;
  background: var(--c-bg);
  border-radius: var(--r-sm);
  padding: 22rpx;
  font-size: var(--fs-base);
  line-height: 1.8;
}

/* 背诵模式 */
.recite-card {
  background: #fff;
  border-radius: var(--r-lg);
  padding: 48rpx 32rpx;
  margin-bottom: 24rpx;
  min-height: 420rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.recite-step { font-size: var(--fs-sm); color: var(--c-text-3); }
.recite-k {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  margin: 20rpx 0 32rpx;
  color: var(--c-primary-dark);
}
.recite-hint {
  padding: 36rpx 0;
  text-align: center;
  color: var(--c-text-3);
  font-size: var(--fs-sm);
  border-top: 1rpx dashed var(--c-line);
}
.recite-v {
  font-size: var(--fs-lg);
  line-height: 1.85;
  background: var(--c-primary-light);
  border-radius: var(--r-sm);
  padding: 24rpx;
  color: #1b3f8f;
}

.action-sub { display: flex; justify-content: center; gap: 60rpx; padding: 16rpx 0; }
.link-btn { font-size: var(--fs-base); color: var(--c-text-2); }

.footer-tip {
  text-align: center;
  color: var(--c-text-3);
  font-size: 20rpx;
  padding: 32rpx 16rpx 20rpx;
  line-height: 1.7;
}
