/* pages-study/search/search.wxss */
.page { padding: 20rpx 24rpx 60rpx; }

.search-bar {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 999rpx;
  padding: 0 26rpx;
  height: 84rpx;
  margin-bottom: 28rpx;
}
.search-icon { font-size: 28rpx; margin-right: 12rpx; }
.search-input { flex: 1; font-size: var(--fs-base); }
.ph { color: #b7bec9; font-size: var(--fs-sm); }

.sec { margin-bottom: 36rpx; }
.sec-title { display: block; font-size: var(--fs-base); font-weight: 600; margin-bottom: 18rpx; }
.sec-head { margin: 28rpx 0 16rpx; }

.word-wrap { display: flex; flex-wrap: wrap; gap: 16rpx; }
.word-chip {
  font-size: var(--fs-sm);
  color: var(--c-primary);
  background: #fff;
  border-radius: 999rpx;
  padding: 12rpx 26rpx;
}
.word-chip.gray { color: var(--c-text-2); background: #eceff5; }

.result-item {
  background: #fff;
  border-radius: var(--r-md);
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.ri-subject {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  background: var(--c-primary-light);
  color: var(--c-primary);
  font-weight: 600;
}
.ri-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.45;
  margin: 14rpx 0 6rpx;
}
.ri-core {
  display: block;
  font-size: var(--fs-sm);
  color: var(--c-text-3);
  line-height: 1.6;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
