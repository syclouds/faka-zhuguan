/* pages/index/index.wxss */
.page {
  padding: 20rpx 24rpx 40rpx;
}

/* ---------- 倒计时 ---------- */
.hero {
  position: relative;
  border-radius: var(--r-lg);
  padding: 44rpx 32rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, #4a86ff 0%, #2b6cf6 55%, #1a52cc 100%);
  color: #fff;
  box-shadow: 0 12rpx 32rpx rgba(43, 108, 246, 0.28);
}
.hero-inner { display: flex; flex-direction: column; }
.hero-label { font-size: var(--fs-sm); opacity: 0.85; }
.hero-days { display: flex; align-items: baseline; margin: 8rpx 0; }
.hero-num {
  font-size: 88rpx;
  font-weight: 700;
  line-height: 1.1;
  letter-spacing: 2rpx;
}
.hero-unit { font-size: var(--fs-lg); margin-left: 8rpx; opacity: 0.9; }
.hero-date { font-size: var(--fs-sm); opacity: 0.85; }
.hero-set { font-size: var(--fs-lg); font-weight: 600; margin-top: 12rpx; }
.hero-edit {
  position: absolute;
  right: 28rpx;
  top: 28rpx;
  font-size: var(--fs-xs);
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.22);
}

/* ---------- 今日任务 ---------- */
.section-title { font-size: var(--fs-lg); font-weight: 600; }
.today-card { padding: 28rpx 24rpx; }
.task-row {
  display: flex;
  align-items: center;
  margin: 28rpx 0;
}
.task-item { flex: 1; display: flex; flex-direction: column; align-items: center; }
.task-num { font-size: 52rpx; font-weight: 700; line-height: 1.2; }
.task-label { font-size: var(--fs-xs); color: var(--c-text-3); margin-top: 4rpx; }
.task-split { width: 1rpx; height: 56rpx; background: var(--c-line); }
.c-red { color: var(--c-unknown); }
.c-blue { color: var(--c-primary); }
.c-green { color: var(--c-mastered); }

/* ---------- 进度条 ---------- */
.progress-bar {
  height: 18rpx;
  border-radius: 999rpx;
  background: #eef1f7;
  margin: 20rpx 0 8rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #14b45f, #4ad48c);
  transition: width 0.4s ease;
}
.mt-sm { margin-top: 8rpx; }

/* ---------- 科目 ---------- */
.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 32rpx 4rpx 16rpx;
}
.subject {
  background: #fff;
  border-radius: var(--r-md);
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.subject-head { display: flex; align-items: center; }
.subject-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.subject-name { font-size: 32rpx; font-weight: 600; }
.subject-desc { font-size: var(--fs-xs); color: var(--c-text-3); }

.chapter-scroll {
  white-space: nowrap;
  margin-top: 20rpx;
}
.chapter-chip {
  display: inline-flex;
  align-items: center;
  background: var(--c-bg);
  border-radius: 999rpx;
  padding: 12rpx 22rpx;
  margin-right: 14rpx;
}
.chip-text { font-size: var(--fs-sm); color: var(--c-text-2); }
.chip-count {
  font-size: 20rpx;
  color: var(--c-primary);
  background: var(--c-primary-light);
  border-radius: 999rpx;
  padding: 2rpx 12rpx;
  margin-left: 10rpx;
}

/* ---------- 必考卡 ---------- */
.hot-card { padding: 24rpx; }
.hot-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  margin: 14rpx 0 8rpx;
}
.hot-core {
  display: block;
  font-size: var(--fs-sm);
  color: var(--c-text-2);
  line-height: 1.55;
}

/* ---------- 页脚 ---------- */
.footer-tip {
  text-align: center;
  color: var(--c-text-3);
  font-size: 20rpx;
  padding: 32rpx 24rpx 20rpx;
}

/* ---------- 日期选择弹层 ---------- */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}
.picker-box {
  width: 560rpx;
  background: #fff;
  border-radius: var(--r-md);
  padding: 40rpx 32rpx 24rpx;
  text-align: center;
}
.picker-title { font-size: var(--fs-lg); font-weight: 600; }
.picker-trigger {
  margin: 32rpx 0;
  padding: 24rpx;
  border: 2rpx dashed var(--c-primary);
  border-radius: var(--r-sm);
  color: var(--c-primary);
  font-size: var(--fs-base);
}
.picker-cancel { color: var(--c-text-3); font-size: var(--fs-base); padding: 16rpx; }
