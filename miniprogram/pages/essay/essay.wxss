/* pages/essay/essay.wxss */
.page { padding: 24rpx 24rpx 60rpx; }

.page-head { margin-bottom: 24rpx; }
.page-title { display: block; font-size: 44rpx; font-weight: 700; }
.page-sub { display: block; font-size: var(--fs-sm); color: var(--c-text-3); margin-top: 8rpx; line-height: 1.6; }

.topic-scroll { white-space: nowrap; margin-bottom: 24rpx; }
.topic-chip {
  display: inline-block;
  font-size: var(--fs-sm);
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: #fff;
  color: var(--c-text-2);
  margin-right: 14rpx;
}
.topic-chip.active {
  background: var(--c-primary);
  color: #fff;
  font-weight: 600;
}

.essay-card {
  background: #fff;
  border-radius: var(--r-md);
  padding: 26rpx 24rpx;
  margin-bottom: 20rpx;
}
.ec-topic {
  font-size: 20rpx;
  color: var(--c-primary);
  background: var(--c-primary-light);
  border-radius: 6rpx;
  padding: 4rpx 14rpx;
}
.ec-level { font-size: 20rpx; margin-left: 12rpx; font-weight: 600; }
.ec-fav { font-size: 20rpx; color: var(--c-fuzzy); }

.ec-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  margin: 16rpx 0 18rpx;
  line-height: 1.45;
}

.ec-frame {
  background: var(--c-bg);
  border-radius: var(--r-sm);
  padding: 18rpx;
}
.ec-frame-row { display: flex; margin-bottom: 10rpx; }
.ec-frame-row:last-child { margin-bottom: 0; }
.ec-frame-k {
  font-size: var(--fs-xs);
  color: var(--c-primary-dark);
  font-weight: 600;
  width: 190rpx;
  flex-shrink: 0;
}
.ec-frame-v {
  flex: 1;
  font-size: var(--fs-xs);
  color: var(--c-text-2);
  line-height: 1.6;
}

.ec-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--c-line);
}
.ec-btn { font-size: var(--fs-sm); color: var(--c-primary); font-weight: 600; }

.footer-tip {
  text-align: center;
  color: var(--c-text-3);
  font-size: 20rpx;
  padding: 28rpx 0 20rpx;
  line-height: 1.7;
}
