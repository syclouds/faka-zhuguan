/* pages/review/review.wxss */
.page { padding: 20rpx 24rpx 60rpx; }

/* 概览 */
.overview {
  display: flex;
  background: #fff;
  border-radius: var(--r-md);
  padding: 28rpx 0;
  margin-bottom: 20rpx;
}
.ov-item { flex: 1; display: flex; flex-direction: column; align-items: center; }
.ov-num { font-size: 44rpx; font-weight: 700; line-height: 1.2; }
.ov-label { font-size: var(--fs-xs); color: var(--c-text-3); margin-top: 4rpx; }
.c-red { color: var(--c-unknown); }
.c-blue { color: var(--c-primary); }
.c-green { color: var(--c-mastered); }
.c-orange { color: var(--c-fuzzy); }

/* Tabs */
.tabs {
  display: flex;
  background: #fff;
  border-radius: var(--r-md);
  padding: 6rpx 0 0;
  margin-bottom: 20rpx;
}
.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 18rpx 0 12rpx;
}
.tab-text { font-size: var(--fs-base); color: var(--c-text-3); }
.tab.active .tab-text { color: var(--c-primary); font-weight: 600; }
.tab-line {
  width: 44rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: var(--c-primary);
  margin-top: 8rpx;
}

.tip-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 8rpx 16rpx;
}

/* 分组卡 */
.group-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: var(--r-md);
  padding: 26rpx 24rpx;
  margin-bottom: 16rpx;
}
.group-dot {
  width: 16rpx;
  height: 56rpx;
  border-radius: 999rpx;
  margin-right: 20rpx;
}
.group-name { display: block; font-size: 30rpx; font-weight: 600; }

/* 列表项 */
.list-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: var(--r-md);
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.li-left { margin-right: 18rpx; }
.li-subject {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-weight: 600;
}
.li-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.45;
}
.li-core {
  display: block;
  font-size: var(--fs-xs);
  color: var(--c-text-3);
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.li-arrow { color: var(--c-text-3); margin-left: 12rpx; }

.mb-16 { margin-bottom: 24rpx; }
.footer-tip {
  text-align: center;
  color: var(--c-text-3);
  font-size: 20rpx;
  padding: 28rpx 0 20rpx;
}
